{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://brapi.dev https://*.googleapis.com https://*.firebaseio.com https://securetoken.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/carteira-data.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "carteira-data.sample.js",
      "use": "@vercel/static"
    },
    {
      "src": "vendor/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "advanced-engine.js",
      "use": "@vercel/static"
    },
    {
      "src": "benchmark-engine.js",
      "use": "@vercel/static"
    },
    {
      "src": "data-trust-engine.js",
      "use": "@vercel/static"
    },
    {
      "src": "init-carteira.js",
      "use": "@vercel/static"
    },
    {
      "src": "mc-worker.js",
      "use": "@vercel/static"
    },
    {
      "src": "monte-carlo-engine.js",
      "use": "@vercel/static"
    },
    {
      "src": "panels.js",
      "use": "@vercel/static"
    },
    {
      "src": "real-mode.js",
      "use": "@vercel/static"
    },
    {
      "src": "rebalance-engine.js",
      "use": "@vercel/static"
    },
    {
      "src": "risk-engine.js",
      "use": "@vercel/static"
    },
    {
      "src": "router.js",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "tax-engine.js",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/carteira-data.js",
      "destination": "/carteira-data.sample.js"
    }
  ]
}
