# Vercel CLI uses this file as the deployment exclusion list.
# Financial data, personal files, and local-only configuration must never ship.
/carteira-data.js
/carteira-data-real.json
/carteira-data-backup*
/data.js
/parsed_data.json
/backup-carteira-*.json
/backup-*.json
/*-backup-*.json
/*-backup-*.js

# Statements, exports, spreadsheets, and uploads
**/uploads/**
**/upload/**
**/backups/**
**/exports/**
**/*extrato*
**/*statement*
*.pdf
*.xls
*.xlsx
*.ods
*.csv
*.ofx
*.qif
*.qfx
*.xml
*.odt
/uploads/
/upload/
/backups/

